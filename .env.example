# EJEMPLO - NO colocar secretos reales en este archivo

# Aplicación
APP_ENV=development
APP_URL=http://localhost:3000
INSTITUTION_TIMEZONE=America/Argentina/Buenos_Aires

# Base de datos
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Supabase (si se utiliza)
