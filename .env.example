NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REEMPLAZAR_CON_CLAVE_PUBLICABLE
SUPABASE_SERVICE_ROLE_KEY=SOLO_BACKEND_NO_SUBIR_VALOR_REAL

# OpenAI (solo backend)
OPENAI_API_KEY=NO_COLOCAR_VALOR_REAL_EN_GITHUB

# Web Push (notificaciones del turno). Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=REEMPLAZAR_CON_CLAVE_PUBLICA_VAPID
VAPID_PRIVATE_KEY=SOLO_BACKEND_NO_SUBIR_VALOR_REAL
